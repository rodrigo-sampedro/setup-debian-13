#!/usr/bin/env bats
# =============================================================================
# test/test_utils.bats - Unit tests for src/lib/utils.sh
# =============================================================================

# Cargar helpers comunes
load test_helper/common

setup() {
  common_setup
  
  # Source required functions
  source "${LIB_DIR}/logging.sh"
  source "${LIB_DIR}/utils.sh"
}

teardown() {
  common_teardown
}

# =============================================================================
# Tests for load_last_step()
# =============================================================================

@test "load_last_step() returns 0 when state file does not exist" {
  rm -f "$STATE_FILE"
  
  run load_last_step
  
  assert_success
  assert_output "0"
}

@test "load_last_step() returns saved step number" {
  echo "5" > "$STATE_FILE"
  
  run load_last_step
  
  assert_success
  assert_output "5"
}

@test "load_last_step() handles multiline content correctly" {
  echo "10" > "$STATE_FILE"
  
  run load_last_step
  
  assert_output "10"
}

# =============================================================================
# Tests for save_last_step()
# =============================================================================

@test "save_last_step() writes step number to state file" {
  DRY_RUN=false
  
  save_last_step 3
  
  assert_file_exists "$STATE_FILE"
  run cat "$STATE_FILE"
  assert_output "3"
}

@test "save_last_step() overwrites existing state file" {
  echo "1" > "$STATE_FILE"
  DRY_RUN=false
  
  save_last_step 7
  
  run cat "$STATE_FILE"
  assert_output "7"
}

@test "save_last_step() does not write in DRY_RUN mode" {
  DRY_RUN=true
  
  save_last_step 5
  
  assert_file_not_exists "$STATE_FILE"
}

# =============================================================================
# Tests for clear_last_step()
# =============================================================================

@test "clear_last_step() removes existing state file" {
  echo "5" > "$STATE_FILE"
  
  run clear_last_step
  
  assert_success
  assert_file_not_exists "$STATE_FILE"
  assert_output --partial "Progress file cleared"
}

@test "clear_last_step() handles non-existent state file gracefully" {
  rm -f "$STATE_FILE"
  
  run clear_last_step
  
  assert_success
  assert_output --partial "No progress file to clear"
}

# =============================================================================
# Tests for join_by()
# =============================================================================

@test "join_by() joins array elements with separator" {
  run join_by ", " "apple" "banana" "cherry"
  
  assert_success
  assert_output "apple, banana, cherry"
}

@test "join_by() works with single element" {
  run join_by ", " "apple"
  
  assert_success
  assert_output "apple"
}

@test "join_by() works with empty list" {
  run join_by ", "
  
  assert_success
  assert_output ""
}

@test "join_by() works with different separators" {
  run join_by " | " "one" "two" "three"
  
  assert_output "one | two | three"
}

@test "join_by() handles spaces in elements" {
  run join_by "," "item one" "item two"
  
  assert_output "item one,item two"
}

# =============================================================================
