# =============================================================================
# Tests for check_os()
# =============================================================================

@test "check_os() succeeds on Debian 13" {
  # Create mock os-release file
  local mock_os_release="${TEST_TEMP_DIR}/os-release"
  cat > "$mock_os_release" << EOF
NAME="Debian GNU/Linux"
VERSION="13 (trixie)"
ID=debian
PRETTY_NAME="Debian GNU/Linux 13 (trixie)"
EOF
  
  # Override function to use mock file
  check_os() {
    if grep -q "Debian GNU/Linux 13" "$mock_os_release"; then
      ok "Debian 13 detected"
    else
      fail "Unsupported OS - This script requires Debian 13"
    fi
  }
  
  run check_os
  
  assert_success
  assert_output --partial "Debian 13 detected"
}

@test "check_os() fails on non-Debian 13 systems" {
  local mock_os_release="${TEST_TEMP_DIR}/os-release"
  cat > "$mock_os_release" << EOF
NAME="Ubuntu"
VERSION="22.04 LTS"
ID=ubuntu
EOF
  
  check_os() {
    if grep -q "Debian GNU/Linux 13" "$mock_os_release"; then
      ok "Debian 13 detected"
    else
      fail "Unsupported OS - This script requires Debian 13"
    fi
  }
  
  run check_os
  
  assert_failure
  assert_output --partial "Unsupported OS"
}

