# =============================================================================
# Integration tests
# =============================================================================

@test "state file workflow: save, load, clear" {
  DRY_RUN=false
  
  # Save step
  save_last_step 5
  assert_file_exists "$STATE_FILE"
  
  # Load step
  result=$(load_last_step)
  assert_equal "$result" "5"
  
  # Update step
  save_last_step 10
  result=$(load_last_step)
  assert_equal "$result" "10"
  
  # Clear step
  clear_last_step >/dev/null
  assert_file_not_exists "$STATE_FILE"
  
  # Load after clear returns 0
  result=$(load_last_step)
  assert_equal "$result" "0"
}

@test "join_by works with bash arrays" {
  local arr=("one" "two" "three")
  
  run join_by ", " "${arr[@]}"
  
  assert_output "one, two, three"
}

@test "multiple commands_exists calls work correctly" {
  run command_exists "bash"
  assert_success
  
  run command_exists "nonexistent_xyz"
  assert_failure
  
  run command_exists "cat"
  assert_success
}